{
  "name": "sapi-typedoc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "基于官方 @minecraft/*.d.ts 生成的中文 Minecraft Script API 参考文档（TypeDoc + Rspress）",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:translate && npm run docs:sync && rspress dev",
    "build": "npm run build:translate && npm run docs:sync && rspress build",
    "preview": "rspress preview",
    "build:translate": "tsx ./script/cli.ts build",
    "build:translate-original": "tsx ./script/cli.ts build-original",
    "update": "tsx ./script/cli.ts update",
    "update-cached": "tsx ./script/cli.ts update-cached",
    "update:ci": "tsx ./script/cli.ts update-ci",
    "update:ci-cached": "tsx ./script/cli.ts update-ci-cached",
    "docs:sync": "tsx ./script/official-data-cli.ts",
    "lint": "eslint .",
    "format": "biome format --write",
    "check": "biome check --write"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@rspress/core": "^2.0.18",
    "@rspress/plugin-typedoc": "^2.0.19",
    "semver": "^7.8.5",
    "ts-morph": "^28.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@eslint/js": "^10.0.1",
    "@rslint/core": "^0.5.3",
    "@types/node": "^22.8.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "type-fest": "^5.8.0",
    "typescript-eslint": "^8.59.4"
  }
}
