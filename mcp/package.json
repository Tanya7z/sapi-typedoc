{
  "name": "sapi-docs-mcp",
  "version": "1.2.0",
  "description": "Minecraft Script API 中文文档 MCP（sapi.dogelake.cn）：检索、结构化符号、版本解析与脚本工程脚手架",
  "type": "module",
  "license": "MIT",
  "author": "Tanya7z",
  "homepage": "https://sapi.dogelake.cn/mcp-install.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanya7z/sapi-typedoc.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "minecraft",
    "script-api",
    "sapi",
    "documentation"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sapi-docs-mcp": "bin/sapi-docs-mcp.mjs",
    "sapi-docs-mcp-http": "bin/sapi-docs-mcp-http.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "tsx --test src/resolve-versions.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
