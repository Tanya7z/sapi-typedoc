[Unit]
Description=sapi-docs-mcp HTTP (Streamable MCP)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sapi-docs-mcp
Environment=NODE_ENV=production
Environment=MCP_HOST=127.0.0.1
Environment=PORT=3921
Environment=SAPI_DOCS_BASE_URL=https://sapi.dogelake.cn
ExecStart=/usr/bin/node /opt/sapi-docs-mcp/dist/http.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
